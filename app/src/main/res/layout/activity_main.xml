<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:id="@+id/main"
    tools:context=".MainActivity">
    <!-- TextView using sp for scale-independent text sizing -->
    <TextView
        android:id="@+id/txt_architecture_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UI Architecture Demo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />
    <!-- View primitive serving as a visual divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#0F5229"
        android:layout_marginBottom="16dp" />
    <!-- Sample user input field using dp for margins/padding -->
    <EditText
        android:id="@+id/edt_student_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Student ID"
        android:padding="12dp"
        android:inputType="number" />
</LinearLayout>